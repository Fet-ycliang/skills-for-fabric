{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "fabric-consumption",
  "description": "Consumer skills for interactive Microsoft Skills for Fabric operations - queries, exploration, monitoring",
  "version": "0.3.11",
  "license": "MIT",
  "repository": "https://github.com/microsoft/skills-for-fabric",
  "keywords": [
    "fabric",
    "microsoft-fabric",
    "consumption",
    "query",
    "exploration"
  ],
  "skills": [
    "./skills/check-updates",
    "./skills/fabriciq",
    "./skills/sqldw-consumption-cli",
    "./skills/sqldb-cli",
    "./skills/spark-consumption-cli",
    "./skills/eventhouse-cli",
    "./skills/eventstream-cli",
    "./skills/eventschemaset-consumption-cli",
    "./skills/activator-cli",
    "./skills/dataflows-cli",
    "./skills/search-consumption-cli",
    "./skills/fabriciq-ontology-cli"
  ],
  "agents": [
    "./agents/FabricAdmin.agent.md",
    "./agents/FabricDataEngineer.agent.md",
    "./agents/FabricAppDev.agent.md",
    "./agents/FabricIQ.agent.md"
  ],
  "mcpServers": {
    "FabricIQ": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/fabricaihub/integrations/m365",
      "headers": {
        "X-VARIANTS": "Fabric.Routing.PowerBIDataExploration"
      },
      "tools": [
        "*"
      ]
    },
    "fabric-sqlendpoint": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/dataPlane/sqlEndpoint",
      "tools": [
        "execute_query"
      ]
    }
  }
}
